# ==================================================
# Token of Halawa Environment Variables Template
# ==================================================

# Server Configuration
PORT=
NODE_ENV=

# Database Connection (PostgreSQL)
DATABASE_URL=

# Authentication & JWT Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=

# Redis Cache & Rate Limiting
REDIS_URL=

# API Throttling
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=

# Frontend Configuration
NEXT_PUBLIC_API_URL=

# Email / SMTP Settings (Optional / Future Integration)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Payment Gateways (Razorpay / Stripe)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Media Storage (Cloudinary / UploadThing)
CLOUDINARY_URL=
UPLOADTHING_TOKEN=

# Third-Party Auth & APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
