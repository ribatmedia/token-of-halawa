datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. Core Tenant & Organization
// -------------------------------------------------------------
model Organization {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  logoUrl       String?
  faviconUrl    String?
  currency      String         @default("USD")
  timezone      String         @default("UTC")
  primaryPhone  String?
  primaryEmail  String?
  address       String?
  status        String         @default("ACTIVE") // ACTIVE, SUSPENDED, DELETED
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  // Relations
  users         User[]
  zones         Zone[]
  campaigns     Campaign[]
  settings      Setting[]
  receipts      Receipt[]
  auditLogs     AuditLog[]
  activityLogs  ActivityLog[]
  reports       Report[]
  exports       Export[]
  backupLogs    BackupLog[]
  systemLogs    SystemLog[]
  announcements Announcement[]
  donors        Donor[]
  handovers     ClassHandover[]
}

// -------------------------------------------------------------
// 2. Organization Hierarchy Structure
// -------------------------------------------------------------
model Zone {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id])
  districts      District[]
}

model District {
  id        String    @id @default(uuid())
  zoneId    String
  name      String
  code      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  zone      Zone      @relation(fields: [zoneId], references: [id])
  sectors   Sector[]
}

model Sector {
  id         String    @id @default(uuid())
  districtId String
  name       String
  code       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  district   District  @relation(fields: [districtId], references: [id])
  units      Unit[]
}

model Unit {
  id        String     @id @default(uuid())
  sectorId  String
  name      String
  code      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  sector    Sector     @relation(fields: [sectorId], references: [id])
  classes   Class[]
  leaders   Leader[]
  volunteers Volunteer[]
  donors    Donor[]
}

model Class {
  id         String      @id @default(uuid())
  unitId     String
  name       String
  grade      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  unit       Unit        @relation(fields: [unitId], references: [id])
  volunteers Volunteer[]
  donors     Donor[]
}

// -------------------------------------------------------------
// 3. User, Roles & Permissions (RBAC)
// -------------------------------------------------------------
model User {
  id             String         @id @default(uuid())
  organizationId String
  email          String         @unique
  passwordHash   String
  fullName       String
  phone          String?
  avatarUrl      String?
  status         String         @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED, DELETED
  isTwoFactorEnabled Boolean    @default(false)
  twoFactorSecret String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization   Organization   @relation(fields: [organizationId], references: [id])
  userRoles      UserRole[]
  sessions       Session[]
  devices        Device[]
  otps           Otp[]
  tokens         Token[]
  apiKeys        ApiKey[]
  auditLogs      AuditLog[]     @relation("AuditUser")
  activityLogs   ActivityLog[]  @relation("ActivityUser")
  volunteerProfile Volunteer?
  leaderProfile  Leader?
  attendanceRecords Attendance[] @relation("RecorderUser")
  assignedTasks  Task[]         @relation("TaskAssignee")
  createdTasks   Task[]         @relation("TaskCreator")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // SUPER_ADMIN, ORG_ADMIN, AREA_MANAGER, CLASS_LEADER, VOLUNTEER, AUDITOR
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique // e.g., "donations:create", "reports:read", "settings:write"
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// -------------------------------------------------------------
// 4. Staff & Field Roles
// -------------------------------------------------------------
model Volunteer {
  id             String       @id @default(uuid())
  userId         String       @unique
  unitId         String?
  classId        String?
  hnNumber       String?      // HN code for campaigner identification
  className      String?      // Denormalized class name
  dailyTarget    Decimal      @default(0.00) @db.Decimal(12, 2)
  monthlyTarget  Decimal      @default(0.00) @db.Decimal(12, 2)
  status         String       @default("ACTIVE") // ACTIVE, INACTIVE, LEAVE
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  user           User         @relation(fields: [userId], references: [id])
  unit           Unit?        @relation(fields: [unitId], references: [id])
  class          Class?       @relation(fields: [classId], references: [id])
  donations      Donation[]
  campaigns      CampaignMember[]
  badges         UserBadge[]
  achievements   UserAchievement[]
  attendance     Attendance[] @relation("VolunteerAttendance")
}

model Leader {
  id             String       @id @default(uuid())
  userId         String       @unique
  unitId         String?
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  user           User         @relation(fields: [userId], references: [id])
  unit           Unit?        @relation(fields: [unitId], references: [id])
}

// -------------------------------------------------------------
// 5. Donor Profiling
// -------------------------------------------------------------
model Donor {
  id             String         @id @default(uuid())
  organizationId String
  uniqueId       String         @unique // Formatted: TOH-D-XXXXXX
  membershipNo   String?        @unique
  qrCodeUrl      String?
  photoUrl       String?
  name           String
  fatherName     String?
  gender         String?
  dob            DateTime?
  phone          String
  whatsApp       String?
  email          String?
  occupation     String?
  category       String         @default("GENERAL") // PREMIUM, GENERAL, WIDOW, ORPHAN, POOR
  donationPlan   String         @default("MONTHLY") // MONTHLY, YEARLY, ONE_OFF
  location       String?
  status         String         @default("ACTIVE") // ACTIVE, INACTIVE, DECEASED, MERGED
  uniqueHash     String         @unique // Concatenated / normalized details
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization   Organization   @relation(fields: [organizationId], references: [id])
  unitId         String?
  unit           Unit?          @relation(fields: [unitId], references: [id])
  classId        String?
  class          Class?         @relation(fields: [classId], references: [id])

  addresses      DonorAddress[]
  familyMembers  DonorFamilyMember[]
  documents      DonorDocument[]
  donations      Donation[]
  renewals       Renewal[]
  mergeSource    DonorMerge[]   @relation("MergedFrom")
  mergeTarget    DonorMerge[]   @relation("MergedTo")
}

model DonorAddress {
  id             String    @id @default(uuid())
  donorId        String
  addressType    String    @default("HOME") // HOME, WORK, PERMANENT
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String?
  country        String    @default("IN")
  latitude       Decimal?  @db.Decimal(9, 6)
  longitude      Decimal?  @db.Decimal(9, 6)
  googleMapUrl   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  donor          Donor     @relation(fields: [donorId], references: [id], onDelete: Cascade)
}

model DonorFamilyMember {
  id           String    @id @default(uuid())
  donorId      String
  name         String
  relationship String
  phone        String?
  dob          DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  donor        Donor     @relation(fields: [donorId], references: [id], onDelete: Cascade)
}

model DonorDocument {
  id             String    @id @default(uuid())
  donorId        String
  documentName   String
  documentType   String    @default("GOVT_ID") // GOVT_ID, BIO, AGREEMENT
  documentUrl    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  donor          Donor     @relation(fields: [donorId], references: [id], onDelete: Cascade)
}

model DonorMerge {
  id             String    @id @default(uuid())
  mergedFromId   String
  mergedToId     String
  reason         String?
  mergedAt       DateTime  @default(now())

  mergedFrom     Donor     @relation("MergedFrom", fields: [mergedFromId], references: [id])
  mergedTo       Donor     @relation("MergedTo", fields: [mergedToId], references: [id])
}

// -------------------------------------------------------------
// 6. Campaigns & Goals
// -------------------------------------------------------------
model Campaign {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  description    String?
  goalAmount     Decimal          @db.Decimal(12, 2)
  collectedAmount Decimal         @default(0.00) @db.Decimal(12, 2)
  startDate      DateTime
  endDate        DateTime?
  status         String           @default("UPCOMING") // UPCOMING, ACTIVE, PAUSED, COMPLETED, CANCELLED
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization   Organization     @relation(fields: [organizationId], references: [id])
  members        CampaignMember[]
  donations      Donation[]
  goals          Goal[]
}

model CampaignMember {
  id         String    @id @default(uuid())
  campaignId String
  volunteerId String
  role       String    @default("MEMBER") // COORDINATOR, MEMBER, LEADER
  createdAt  DateTime  @default(now())

  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  volunteer  Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, volunteerId])
}

// -------------------------------------------------------------
// 7. Donations, Payments & Receipts
// -------------------------------------------------------------
model Donation {
  id               String       @id @default(uuid())
  donorId          String
  volunteerId      String?
  campaignId       String?
  donationType     String       @default("GENERAL") // MONTHLY, ZAKAT, SADAQAH, EMERGENCY, EDUCATION, GENERAL
  frequency        String       @default("ONE_OFF") // ONE_OFF, MONTHLY, YEARLY
  amount           Decimal      @db.Decimal(12, 2)
  status           String       @default("PENDING") // PENDING, VERIFIED, REJECTED, HOLD, CANCELLED, REFUNDED
  notes            String?
  offlineSynced    Boolean      @default(false)

  // Mahabba-specific fields
  donationMonth    String?      // Months covered: e.g. "Jun, Jul, Aug"
  monthPlan        String?      // Plan rate: e.g. "100/month"
  isVerified       Boolean      @default(false)
  verifiedMonths   String?      // Comma-separated verified months
  initialAmount    Decimal?     @db.Decimal(12, 2) // First transaction amount
  campaignerName   String?      // Denormalized campaigner name
  campaignerClass  String?      // Denormalized campaigner class
  receiptNo        String?      // Unique receipt number: MHB-YEAR-XXXX

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  donor            Donor        @relation(fields: [donorId], references: [id])
  volunteer        Volunteer?   @relation(fields: [volunteerId], references: [id])
  campaign         Campaign?    @relation(fields: [campaignId], references: [id])
  payments         Payment[]
  receipts         Receipt[]
  workflowLogs     WorkflowLog[]
}

model Payment {
  id             String        @id @default(uuid())
  donationId     String
  paymentMethodId String
  amount         Decimal       @db.Decimal(12, 2)
  transactionRef String?       @unique
  paymentGateway String?       // RAZORPAY, STRIPE, UPI, MANUAL
  status         String        @default("PENDING") // PENDING, SUCCESS, FAILED
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  donation       Donation      @relation(fields: [donationId], references: [id])
  paymentMethod  PaymentMethod @relation(fields: [paymentMethodId], references: [id])
}

model PaymentMethod {
  id             String    @id @default(uuid())
  name           String    @unique // CASH, UPI, BANK_TRANSFER, CARD, CHEQUE, WALLET
  isEnabled      Boolean   @default(true)
  createdAt      DateTime  @default(now())

  payments       Payment[]
}

model Receipt {
  id             String        @id @default(uuid())
  organizationId String
  donationId     String
  receiptNumber  String        @unique // Format: TOH-2026-000001
  digitalSignature String
  qrCodeUrl      String?
  pdfUrl         String?
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id])
  donation       Donation      @relation(fields: [donationId], references: [id])
  items          ReceiptItem[]
}

model ReceiptItem {
  id          String   @id @default(uuid())
  receiptId   String
  description String
  amount      Decimal  @db.Decimal(12, 2)

  receipt     Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

model Renewal {
  id             String    @id @default(uuid())
  donorId        String
  status         String    @default("NEW") // NEW, RENEWED, UPGRADED, DOWNGRADED, EXPIRED, CANCELLED
  nextDueDate    DateTime
  missedMonths   Int       @default(0)
  outstandingAmt Decimal   @default(0.00) @db.Decimal(12, 2)
  lastPaymentAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  donor          Donor     @relation(fields: [donorId], references: [id])
}

// -------------------------------------------------------------
// 8. Workflow Logs & Approval Trails
// -------------------------------------------------------------
model WorkflowLog {
  id             String    @id @default(uuid())
  donationId     String
  actorRole      String    // VOLUNTEER, LEADER, AREA_MANAGER, ADMIN
  actorId        String    // User ID
  action         String    // SUBMITTED, APPROVED, REJECTED, HOLD
  comments       String?
  timestamp      DateTime  @default(now())

  donation       Donation  @relation(fields: [donationId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 9. Systems, Verification & Auditing
// -------------------------------------------------------------
model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String       // CREATE, UPDATE, DELETE, MERGE, EXPORT
  tableName      String
  rowId          String
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User?        @relation("AuditUser", fields: [userId], references: [id])
}

model ActivityLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  description    String
  ipAddress      String?
  browser        String?
  location       String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User?        @relation("ActivityUser", fields: [userId], references: [id])
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  refreshToken   String    @unique
  tokenExpiry    DateTime
  ipAddress      String?
  userAgent      String?
  isValid        Boolean   @default(true)
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Device {
  id             String    @id @default(uuid())
  userId         String
  deviceFingerprint String
  os             String?
  browser        String?
  lastLoginAt    DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 10. Notifications & Templates
// -------------------------------------------------------------
model Notification {
  id             String    @id @default(uuid())
  channel        String    // WHATSAPP, SMS, EMAIL, PUSH, TELEGRAM
  recipient      String    // phone/email address
  subject        String?
  body           String
  status         String    @default("PENDING") // PENDING, SENT, FAILED
  errorMessage   String?
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
}

model NotificationTemplate {
  id          String   @id @default(uuid())
  name        String   @unique // RECEIPT_NOTIFICATION, RENEWAL_REMINDER, BROADCAST_PROMO
  channel     String   // WHATSAPP, SMS, EMAIL
  body        String   // Message template, supports {{donor_name}} etc
  variables   String[]
  language    String   @default("en") // en, ml, ar, ta
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -------------------------------------------------------------
// 11. Settings & Infrastructure
// -------------------------------------------------------------
model Setting {
  id             String       @id @default(uuid())
  organizationId String
  key            String
  value          String
  category       String       @default("GENERAL") // GENERAL, WHATSAPP, RECEIPT, BACKUP, THEME
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
}

model Report {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  reportType     String       // FINANCIAL, VOLUNTEER, RENEWAL, OUTSTANDING
  parameters     Json?
  filePath       String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Export {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  format         String       // CSV, EXCEL, PDF
  status         String       @default("PENDING") // PENDING, READY, FAILED
  filePath       String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Task {
  id             String    @id @default(uuid())
  creatorId      String
  assigneeId     String?
  title          String
  description    String?
  status         String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  priority       String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  dueDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignee       User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator        User      @relation("TaskCreator", fields: [creatorId], references: [id])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  eventDate   DateTime
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Goal {
  id          String    @id @default(uuid())
  campaignId  String
  title       String
  targetValue Decimal   @db.Decimal(12, 2)
  currentVal  Decimal   @default(0.00) @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Leaderboard {
  id          String   @id @default(uuid())
  type        String   // VOLUNTEER, CLASS, AREA, DISTRICT, CAMPAIGN, DONOR
  period      String   // MONTHLY, YEARLY, CUSTOM
  startDate   DateTime
  endDate     DateTime
  rankings    Json     // Array of structured JSON: [{ rank: 1, name: "Name", score: 1000 }]
  createdAt   DateTime @default(now())
}

model Badge {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  iconUrl     String?
  criteria    Json?             // Rules defining how it is achieved
  createdAt   DateTime          @default(now())

  volunteers  UserBadge[]
}

model UserBadge {
  volunteerId String
  badgeId     String
  awardedAt   DateTime          @default(now())

  volunteer   Volunteer         @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  badge       Badge             @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([volunteerId, badgeId])
}

model Achievement {
  id          String            @id @default(uuid())
  title       String            @unique
  description String?
  threshold   Decimal           @db.Decimal(12, 2)
  createdAt   DateTime          @default(now())

  volunteers  UserAchievement[]
}

model UserAchievement {
  volunteerId   String
  achievementId String
  unlockedAt    DateTime    @default(now())

  volunteer     Volunteer   @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([volunteerId, achievementId])
}

model Otp {
  id          String   @id @default(uuid())
  userId      String
  otpCode     String
  purpose     String   // LOGIN, 2FA, PASSWORD_RESET
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Token {
  id          String   @id @default(uuid())
  userId      String
  tokenValue  String   @unique
  tokenType   String   // REFRESH_TOKEN, VERIFICATION_TOKEN
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id          String    @id @default(uuid())
  userId      String
  keyHash     String    @unique
  name        String
  scopes      String[]  // Array of endpoints/actions permitted
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  lastUsedAt  DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BackupLog {
  id             String       @id @default(uuid())
  organizationId String
  fileName       String
  fileSize       Int
  status         String       @default("SUCCESS") // SUCCESS, FAILED
  errorMessage   String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model SystemLog {
  id             String       @id @default(uuid())
  organizationId String
  level          String       // INFO, WARN, ERROR, FATAL
  message        String
  context        String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Announcement {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  content        String
  targetAudience String       // ALL, VOLUNTEERS, LEADERS, MANAGERS
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Attendance {
  id             String    @id @default(uuid())
  volunteerId    String
  recordedById   String
  status         String    @default("PRESENT") // PRESENT, ABSENT, LATE, LEAVE
  date           DateTime
  createdAt      DateTime  @default(now())

  volunteer      Volunteer @relation("VolunteerAttendance", fields: [volunteerId], references: [id], onDelete: Cascade)
  recorder       User      @relation("RecorderUser", fields: [recordedById], references: [id])
}

// Mahabba: Class Handover model - when a class leader hands over collected amount to admin
model ClassHandover {
  id             String    @id @default(uuid())
  organizationId String
  className      String
  handoverMonth  String
  leaderName     String
  leaderPhone    String?
  amount         Decimal   @db.Decimal(12, 2)
  adminName      String?
  receiptNo      String    @unique // e.g., HND-2026-XXXX
  notes          String?
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
}
